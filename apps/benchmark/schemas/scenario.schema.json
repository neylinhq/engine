{
  "type": "object",
  "properties": {
    "schema": {
      "const": "engine.benchmark.scenario.v1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "scene": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000]+$"
            },
            "materials": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "required": [
            "file"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "size": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "integer",
                "minimum": 16,
                "maximum": 16384,
                "multipleOf": 16
              }
            }
          },
          "required": [
            "size"
          ],
          "additionalProperties": false
        }
      ]
    },
    "voxel_size": {
      "type": "number",
      "minimum": 1e-06,
      "maximum": 1000000.0
    },
    "frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "warmup_frames": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "step_seconds": {
      "type": "number",
      "minimum": 1e-06,
      "maximum": 1
    },
    "memory_interval": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "bounds_budget": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "render": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "mode": {
          "enum": [
            "base",
            "albedo",
            "path_tracer"
          ]
        },
        "fov": {
          "type": "number",
          "minimum": 1,
          "maximum": 120
        },
        "bounces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "settings_file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "settings": {
          "type": "object",
          "properties": {
            "general": {
              "type": "object",
              "properties": {
                "exposure": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 10
                },
                "toneMappingFac": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 10
                },
                "fov": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 120
                },
                "lockTo60fps": {
                  "const": false
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "render": {
              "type": "object",
              "properties": {
                "showSteps": {
                  "type": "boolean"
                },
                "version": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2
                },
                "renderBase": {
                  "type": "object",
                  "properties": {
                    "isDenoise": {
                      "type": "boolean"
                    },
                    "isTAAJitter": {
                      "type": "boolean"
                    },
                    "skipSamples": {
                      "type": "boolean"
                    },
                    "isSampleLeveling": {
                      "type": "boolean"
                    },
                    "isVaryingResmaplingRadius": {
                      "type": "boolean"
                    },
                    "isAtmosphereInteraction": {
                      "type": "boolean"
                    },
                    "taaSampleMaxAge": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 32
                    },
                    "bounceCount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "spatialResampleVisibilityTestMaxDepth": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 80
                    },
                    "denoiseThresh": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 500
                    },
                    "globalIllumMaxAccum": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 128
                    },
                    "radiusLitFactor": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "spatialResampleSize": {
                      "type": "number",
                      "minimum": 2,
                      "maximum": 500
                    },
                    "noiseSupressionFactor": {
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 100
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "renderAlbedo": {
                  "type": "object",
                  "properties": {
                    "isTAAJitter": {
                      "type": "boolean"
                    },
                    "checkSun": {
                      "type": "boolean"
                    },
                    "taaSampleMaxAge": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 32
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "renderPathTracer": {
                  "type": "object",
                  "properties": {
                    "isTAAJitter": {
                      "type": "boolean"
                    },
                    "isAtmosphereInteraction": {
                      "type": "boolean"
                    },
                    "maxSamples": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8192
                    },
                    "bounceCount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "atmosphere": {
              "type": "object",
              "properties": {
                "sunAngle": {
                  "type": "number"
                },
                "sunAzimuth": {
                  "type": "number"
                },
                "sunIntensity": {
                  "type": "number"
                },
                "mieScatter": {
                  "type": "number"
                },
                "sphereRadius": {
                  "type": "number"
                },
                "thickness": {
                  "type": "number"
                },
                "averagePoint": {
                  "type": "number"
                },
                "density": {
                  "type": "number"
                },
                "absorbIntensity": {
                  "type": "number"
                },
                "scatterIntensity": {
                  "type": "number"
                },
                "mieFactor": {
                  "type": "number"
                },
                "sunColor": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number",
                    "minimum": -1000000000.0,
                    "maximum": 1000000000.0
                  }
                },
                "rayleighScatter": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number",
                    "minimum": -1000000000.0,
                    "maximum": 1000000000.0
                  }
                },
                "ozoneAbsorb": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number",
                    "minimum": -1000000000.0,
                    "maximum": 1000000000.0
                  }
                },
                "mainRaySteps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "subScatterSteps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "presentation": {
          "enum": [
            "immediate",
            "mailbox",
            "fifo"
          ]
        },
        "profile": {
          "enum": [
            "frame",
            "updates",
            "passes"
          ]
        },
        "offscreen": {
          "type": "boolean"
        },
        "borderless": {
          "type": "boolean"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "not": {
        "required": ["settings", "settings_file"]
      },
      "additionalProperties": false
    },
    "camera": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999999
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            }
          },
          "yaw": {
            "type": "number",
            "minimum": -1000000.0,
            "maximum": 1000000.0
          },
          "pitch": {
            "type": "number",
            "minimum": -1.55,
            "maximum": 1.55
          }
        },
        "required": [
          "frame",
          "position",
          "yaw",
          "pitch"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999999
              },
              "type": {
                "const": "brush"
              },
              "tool": {
                "enum": [
                  "sphere",
                  "cube",
                  "paint"
                ]
              },
              "center": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                }
              },
              "radius": {
                "type": "number",
                "minimum": 0.001,
                "maximum": 400
              },
              "material": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "erase": {
                "type": "boolean"
              }
            },
            "required": [
              "frame",
              "type",
              "tool",
              "center",
              "radius",
              "material"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999999
              },
              "type": {
                "const": "fill"
              },
              "start": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                }
              },
              "material": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            },
            "required": [
              "frame",
              "type",
              "start",
              "material"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999999
              },
              "type": {
                "const": "stamp"
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000]+$"
              },
              "origin": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                }
              }
            },
            "required": [
              "frame",
              "type",
              "model",
              "origin"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999999
              },
              "type": {
                "const": "spawn"
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000]+$"
              },
              "entity": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000]+$"
              },
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                }
              }
            },
            "required": [
              "frame",
              "type",
              "model",
              "entity",
              "position"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999999
              },
              "type": {
                "const": "move_entity"
              },
              "entity": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000]+$"
              },
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                }
              }
            },
            "required": [
              "frame",
              "type",
              "entity",
              "position"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999999
              },
              "type": {
                "const": "clear_entities"
              }
            },
            "required": [
              "frame",
              "type"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            }
          },
          "material": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "required": [
          "position",
          "material"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "name",
    "scene",
    "voxel_size",
    "frames",
    "warmup_frames",
    "step_seconds",
    "memory_interval",
    "render",
    "camera"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engine benchmark scenario v1",
  "description": "Further semantic checks require ordered camera/events, frame indices below frames, valid entity references, supported settings, and existing external assets."
}
