find_package(Boost 1.92 CONFIG REQUIRED COMPONENTS json)
find_package(Threads REQUIRED)
ac_external(Threads::Threads external.threads "system")

function(engine_external_headers target id version include_dirs subdir)
    set(roots)
    foreach(directory IN LISTS include_dirs)
        list(APPEND roots "${directory}/${subdir}")
    endforeach()
    ac_external("${target}" "${id}" "${version}" ${roots})
endfunction()

engine_external_headers(Boost::json external.boost "${Boost_VERSION}" "${Boost_INCLUDE_DIRS}" boost)
if(WIN32)
    add_library(Windows::CNG INTERFACE IMPORTED)
    target_link_libraries(Windows::CNG INTERFACE bcrypt)
    ac_external(Windows::CNG external.windows_cng "system")
else()
    find_package(OpenSSL 3.6 CONFIG REQUIRED)
    engine_external_headers(OpenSSL::Crypto external.openssl "${OpenSSL_VERSION}" "${OpenSSL_INCLUDE_DIRS}" openssl)
endif()
if(ENGINE_DESKTOP)
    find_package(Vulkan 1.3 REQUIRED)
    ac_external(Vulkan::Vulkan external.vulkan "${Vulkan_VERSION}"
        "${Vulkan_INCLUDE_DIR}/vulkan" "${Vulkan_INCLUDE_DIR}/vk_video")
    find_package(glfw3 3.4 CONFIG REQUIRED)
    engine_external_headers(glfw external.glfw "${glfw3_VERSION}" "${glfw3_INCLUDE_DIRS}" GLFW)
endif()
