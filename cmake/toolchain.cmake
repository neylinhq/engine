include_guard(GLOBAL)
file(TO_CMAKE_PATH "$ENV{ENGINE_LLVM_ROOT}" llvm_root)
if(llvm_root STREQUAL "" OR NOT IS_DIRECTORY "${llvm_root}/bin")
    message(FATAL_ERROR "Set ENGINE_LLVM_ROOT to the LLVM 23.1.5 installation")
endif()

set(CMAKE_LINKER_TYPE LLD CACHE STRING "LLVM linker")
if(CMAKE_HOST_WIN32)
    set(CMAKE_C_COMPILER "${llvm_root}/bin/clang-cl.exe" CACHE FILEPATH "Clang C compiler")
    set(CMAKE_CXX_COMPILER "${llvm_root}/bin/clang-cl.exe" CACHE FILEPATH "Clang C++ compiler")
    set(CMAKE_LINKER "${llvm_root}/bin/lld-link.exe" CACHE FILEPATH "LLVM linker")
    set(CMAKE_AR "${llvm_root}/bin/llvm-lib.exe" CACHE FILEPATH "LLVM librarian")
    set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded CACHE STRING "Shared dependency CRT")
    set(CMAKE_MSVC_DEBUG_INFORMATION_FORMAT Embedded CACHE STRING "Cacheable debug information")
    string(APPEND CMAKE_CXX_FLAGS_INIT " /utf-8")
    string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT " /INCREMENTAL:NO")
else()
    set(CMAKE_C_COMPILER "${llvm_root}/bin/clang" CACHE FILEPATH "Clang C compiler")
    set(CMAKE_CXX_COMPILER "${llvm_root}/bin/clang++" CACHE FILEPATH "Clang C++ compiler")
    set(CMAKE_AR "${llvm_root}/bin/llvm-ar" CACHE FILEPATH "LLVM archiver")
    set(CMAKE_RANLIB "${llvm_root}/bin/llvm-ranlib" CACHE FILEPATH "LLVM archive indexer")
endif()

find_program(ENGINE_SCCACHE sccache REQUIRED)
set(CMAKE_C_COMPILER_LAUNCHER "${ENGINE_SCCACHE}" CACHE FILEPATH "Compiler cache")
set(CMAKE_CXX_COMPILER_LAUNCHER "${ENGINE_SCCACHE}" CACHE FILEPATH "Compiler cache")
