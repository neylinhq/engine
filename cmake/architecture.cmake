include_guard(GLOBAL)
include(CMakeParseArguments)
cmake_file_api(QUERY API_VERSION 1 CODEMODEL 2)

function(ac_register target id is_test)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "Missing target ${target}")
    endif()
    set_property(TARGET "${target}" PROPERTY AC_ID "${id}")
    set_property(TARGET "${target}" PROPERTY AC_TEST "${is_test}")
    file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}")
    set_property(TARGET "${target}" PROPERTY AC_PATH "${relative}")
    set_property(GLOBAL APPEND PROPERTY AC_TARGETS "${target}")
    get_target_property(kind "${target}" TYPE)
    if(kind STREQUAL "INTERFACE_LIBRARY")
        target_compile_features("${target}" INTERFACE cxx_std_23)
    else()
        target_compile_features("${target}" PUBLIC cxx_std_23)
        set_target_properties("${target}" PROPERTIES CXX_EXTENSIONS OFF)
        if(MSVC)
            target_compile_options("${target}" PRIVATE /W4 /WX /utf-8)
        else()
            target_compile_options("${target}" PRIVATE -Wall -Wextra -Wpedantic -Werror)
        endif()
    endif()
endfunction()

function(ac_component target id)
    ac_register("${target}" "${id}" FALSE)
    set_target_properties("${target}" PROPERTIES EXPORT_NAME "${id}")
    add_library("${PROJECT_NAME}::${id}" ALIAS "${target}")

endfunction()
function(ac_application target id)
    ac_register("${target}" "${id}" FALSE)
endfunction()
function(ac_test target owner)
    get_target_property(id "${owner}" AC_ID)
    ac_register("${target}" "${id}" TRUE)
    add_test(NAME "${target}" COMMAND "${target}" ${ARGN})
endfunction()
function(ac_external target id version)
    set_property(TARGET "${target}" PROPERTY AC_ID "${id}")
    set_property(TARGET "${target}" PROPERTY AC_EXTERNAL TRUE)
    set_property(TARGET "${target}" PROPERTY AC_VERSION "${version}")
    set_property(TARGET "${target}" PROPERTY AC_ROOTS "${ARGN}")
    set_property(GLOBAL APPEND PROPERTY AC_EXTERNAL_TARGETS "${target}")
endfunction()

function(ac_export_sources target owner output)
    get_target_property(directory "${target}" SOURCE_DIR)
    get_target_property(sources "${target}" SOURCES)
    get_target_property(interface_sources "${target}" INTERFACE_SOURCES)
    get_target_property(test "${target}" AC_TEST)
    if(NOT sources)
        set(sources "")
    endif()
    if(interface_sources)
        list(APPEND sources ${interface_sources})
        list(REMOVE_DUPLICATES sources)
    endif()
    set(records "")
    foreach(source IN LISTS sources)
        if(source MATCHES "\\$<")
            message(FATAL_ERROR "Use configured source lists, not opaque source generator expressions")
        endif()
        cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${directory}" NORMALIZE OUTPUT_VARIABLE absolute)
        file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${absolute}")
        if(relative MATCHES "^out/")
            message(FATAL_ERROR "Generated sources must be registered with ac_generated: ${relative}")
        endif()
        if(relative MATCHES "/(tests|benchmarks|fuzz)/")
            set(kind test)
        elseif(relative MATCHES "/include/")
            set(kind public)
        else()
            set(kind private)
        endif()
        string(APPEND records "source\t${owner}\t${kind}\t${relative}\n")
        if(kind STREQUAL "public" AND relative MATCHES "\\.hpp$" AND NOT relative MATCHES "/detail/")
            set_property(GLOBAL APPEND PROPERTY AC_HEADERS "${owner}|${target}|${absolute}")
        endif()
    endforeach()
    set("${output}" "${records}" PARENT_SCOPE)
endfunction()

function(ac_export_edges target owner output)
    get_target_property(links "${target}" LINK_LIBRARIES)
    get_target_property(interface "${target}" INTERFACE_LINK_LIBRARIES)
    get_target_property(test "${target}" AC_TEST)
    if(NOT links)
        set(links "")
    endif()
    if(interface)
        foreach(link IN LISTS interface)
            if(NOT link MATCHES "^\\$<LINK_ONLY:")
                list(APPEND links "${link}")
            endif()
        endforeach()
    endif()
    list(REMOVE_DUPLICATES links)
    set(records "")
    foreach(link IN LISTS links)
        if(NOT TARGET "${link}")
            message(FATAL_ERROR "Register dependency as a target: ${link}")
        endif()
        get_target_property(dependency "${link}" AC_ID)
        if(NOT dependency)
            message(FATAL_ERROR "Dependency has no architecture identity: ${link}")
        endif()
        if(test)
            set(scope test)
        elseif(link IN_LIST interface)
            set(scope public)
        else()
            set(scope private)
        endif()
        if(NOT owner STREQUAL dependency)
            string(APPEND records "edge\t${owner}\t${dependency}\t${scope}\n")
        endif()
    endforeach()
    set("${output}" "${records}" PARENT_SCOPE)
endfunction()

function(ac_header_probes output)
    get_property(headers GLOBAL PROPERTY AC_HEADERS)
    list(REMOVE_DUPLICATES headers)
    set(records "")
    foreach(record IN LISTS headers)
        string(REPLACE "|" ";" parts "${record}")
        list(GET parts 0 owner)
        list(GET parts 1 target)
        list(GET parts 2 header)
        string(SHA256 digest "${header}")
        string(SUBSTRING "${digest}" 0 16 digest)
        set(probe "${CMAKE_BINARY_DIR}/probes/${digest}.cpp")
        string(REGEX REPLACE ".*/include/" "" include_path "${header}")
        file(GENERATE OUTPUT "${probe}" CONTENT "#include <${include_path}>\n")
        add_library("ac_probe_${digest}" OBJECT "${probe}")
        target_link_libraries("ac_probe_${digest}" PRIVATE "${target}")
        target_compile_features("ac_probe_${digest}" PRIVATE cxx_std_23)
        set_target_properties("ac_probe_${digest}" PROPERTIES CXX_EXTENSIONS OFF)
        file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${header}")
        string(APPEND records "probe\t${owner}\t${probe}\t${relative}\tac_probe_${digest}\n")
    endforeach()
    set("${output}" "${records}" PARENT_SCOPE)
endfunction()

# Inactive native code remains inventoried and owned. Semantic archcheck reports
# explicit incomplete coverage for it; this is NOT a wildcard ignore or a pass.
function(ac_inactive_sources owner reason)
    if(reason STREQUAL "")
        message(FATAL_ERROR "Inactive source needs a configuration reason")
    endif()
    foreach(source IN LISTS ARGN)
        cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE OUTPUT_VARIABLE absolute)
        file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${absolute}")
        if(relative MATCHES "/(tests|benchmarks|fuzz)/")
            set(kind test)
        elseif(relative MATCHES "/include/")
            set(kind public)
        else()
            set(kind private)
        endif()
        set_property(GLOBAL APPEND_STRING PROPERTY AC_INACTIVE_FACTS
            "source\t${owner}\t${kind}\t${relative}\ninactive_source\t${owner}\t${relative}\t${reason}\n")
    endforeach()
endfunction()
function(ac_inactive_component owner reason)
    file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}")
    set_property(GLOBAL APPEND_STRING PROPERTY AC_INACTIVE_FACTS "component\t${owner}\t${relative}\n")
    ac_inactive_sources("${owner}" "${reason}" ${ARGN})
endfunction()

function(ac_export_facts output)
    set(content "ARCHCHECK_FACTS_V2\nroot\t${PROJECT_SOURCE_DIR}\nbuild\t${CMAKE_BINARY_DIR}\n")
    if(NOT ARCHCHECK_CONFIGURATION)
        string(TOLOWER "${CMAKE_BUILD_TYPE}" ARCHCHECK_CONFIGURATION)
    endif()
    string(APPEND content "configuration\t${ARCHCHECK_CONFIGURATION}\n")
    get_property(inactive GLOBAL PROPERTY AC_INACTIVE_FACTS)
    string(APPEND content "${inactive}")
    get_property(targets GLOBAL PROPERTY AC_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(owner "${target}" AC_ID)
        get_target_property(path "${target}" AC_PATH)
        get_target_property(test "${target}" AC_TEST)
        get_target_property(type "${target}" TYPE)
        if(NOT test)
            string(APPEND content "component\t${owner}\t${path}\n")
        endif()
        if(test)
            set(type TEST)
        endif()
        string(APPEND content "target\t${owner}\t${target}\t${type}\n")
        ac_export_sources("${target}" "${owner}" sources)
        ac_export_edges("${target}" "${owner}" edges)
        string(APPEND content "${sources}${edges}")
    endforeach()
    get_property(externals GLOBAL PROPERTY AC_EXTERNAL_TARGETS)
    foreach(target IN LISTS externals)
        get_target_property(id "${target}" AC_ID)
        get_target_property(version "${target}" AC_VERSION)
        get_target_property(roots "${target}" AC_ROOTS)
        string(APPEND content "external\t${id}\t${version}\n")
        get_target_property(imported "${target}" IMPORTED)
        if(NOT imported)
            string(APPEND content "external_target\t${id}\t${target}\n")
            get_target_property(external_sources "${target}" SOURCES)
            get_target_property(external_directory "${target}" SOURCE_DIR)
            foreach(source IN LISTS external_sources)
                cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${external_directory}" NORMALIZE OUTPUT_VARIABLE absolute)
                string(APPEND content "external_source\t${id}\t${absolute}\n")
            endforeach()
        endif()
        foreach(root IN LISTS roots)
            string(APPEND content "external_root\t${id}\t${root}\n")
        endforeach()
    endforeach()
    ac_header_probes(probes)
    string(APPEND content "${probes}")
    file(GLOB_RECURSE configs LIST_DIRECTORIES FALSE
        "${PROJECT_SOURCE_DIR}/*.toml" "${PROJECT_SOURCE_DIR}/CMakeLists.txt"
        "${PROJECT_SOURCE_DIR}/components/*/CMakeLists.txt"
        "${PROJECT_SOURCE_DIR}/apps/*/CMakeLists.txt" "${PROJECT_SOURCE_DIR}/cmake/*.cmake")
    foreach(config IN LISTS configs)
        file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${config}")
        if(NOT relative MATCHES "^out/")
            file(SHA256 "${config}" hash)
            string(APPEND content "input\t${relative}\t${hash}\n")
        endif()
    endforeach()
    file(WRITE "${output}" "${content}")
endfunction()
